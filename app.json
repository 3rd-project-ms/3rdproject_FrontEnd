{
  "expo": {
    "name": "SimSpeak",
    "slug": "simspeak",
    "version": "1.0.0",
    "scheme": "simspeak",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "package": "com.ms3rdproject_frontend",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FBE9E7"
      }
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "음성 채팅을 위해 마이크가 필요합니다."
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7e05ff2-1cc4-41a4-a02d-03c8f1d9dcbb"
      }
    }
  }
}
